rules_version = '2';

// Source of truth for the Cloud Firestore security rules of Spiza.
// Deploy: paste into Firebase console > Firestore > Rules (or `firebase deploy --only firestore:rules`).
// Any change to collections, fields or who may write them must update this file in the same change.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(household) {
      return isSignedIn() && request.auth.uid in household.joinedMembers;
    }

    function isOwner(household) {
      return isSignedIn() && request.auth.uid == household.ownerId;
    }

    // A household document may only contain these fields, with these types.
    function validHousehold(data) {
      return data.keys().hasOnly(['name', 'description', 'ownerId', 'joinedMembers'])
          && data.name is string
          && data.description is string
          && data.ownerId is string
          && data.joinedMembers is list;
    }

    // The owner may change anything except ownership, and must stay a member.
    // Known limitation: the rules can not verify that an added member used a join key; the app consumes the key in the same batch.
    function ownerUpdate() {
      return isOwner(resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.auth.uid in request.resource.data.joinedMembers
          && validHousehold(request.resource.data);
    }

    // A non-owner member may only change joinedMembers, and only by removing themselves.
    function memberLeaves() {
      return isMember(resource.data)
          && !isOwner(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedMembers'])
          && request.resource.data.joinedMembers.toSet()
               == resource.data.joinedMembers.toSet().difference([request.auth.uid].toSet());
    }

    match /households/{householdId} {
      // The creator must be the owner and the only member.
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.joinedMembers == [request.auth.uid]
                    && validHousehold(request.resource.data);

      allow read: if isMember(resource.data);
      allow update: if ownerUpdate() || memberLeaves();
      allow delete: if isOwner(resource.data);

      // Items are readable and writable by any member of the parent household.
      // get() reads the parent before the request, so a batch that deletes items and then the household is allowed.
      match /items/{itemId} {
        function household() {
          return get(/databases/$(database)/documents/households/$(householdId)).data;
        }

        // An item document may only contain these fields, with these types.
        function validItem(data) {
          return data.keys().hasOnly(['text', 'isChecked', 'position'])
              && data.text is string
              && data.isChecked is bool
              && data.position is number;
        }

        allow read, delete: if isMember(household());
        allow create, update: if isMember(household()) && validItem(request.resource.data);
      }
    }

    match /users/{userId} {
      // Users may only create their own profile document.
      allow create: if isSignedIn()
                    && userId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['name', 'email', 'photoUrl']);

      // Needed to show household members' names and photos. Profiles are fetched by id only, and the ids are known only
      // to household co-members and join-key holders; listing is denied so nobody can enumerate profiles and emails.
      allow get: if isSignedIn();
    }

    // Join keys are document ids: joinKeys/{joinKey} -> { userId }. A key is an unguessable UUID, so knowing it is
    // what authorizes reading or consuming it; keys can be fetched by id but only a user's own keys can be listed.
    match /joinKeys/{joinKey} {
      // Users may only create keys for themselves. There is no update: a new key is a new document.
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(['userId'])
                    && request.resource.data.userId == request.auth.uid;

      // The household owner looks the key up by id to find the user to add.
      allow get: if isSignedIn();

      // Users may only query their own keys (to show or replace them).
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Deleted by the owner when adding the member, or by the user when replacing it; both know the key.
      allow delete: if isSignedIn();
    }
  }
}
