{
  "name": "spiza-firestore-rules-tests",
  "private": true,
  "type": "module",
  "description": "Security rules tests for ../firestore.rules, run against the Firestore emulator.",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-spiza \"vitest run\"",
    "test:watch": "firebase emulators:exec --only firestore --project demo-spiza \"vitest\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.2.0",
    "firebase-tools": "15.35.0",
    "vitest": "5.1.0"
  }
}
